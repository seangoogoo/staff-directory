# Environment files
.env
.env.*

# Google Search Console tooling — local to this installation, never published.
# The private key itself is kept OUTSIDE this tree; the entry below only catches
# a stray copy dropped here, and .gitignore stops a commit, never an rsync.
.gsc-sa.json
tools/gsc.sh

# Local-only documentation — NEVER pushed to the public repo.
# Put anything host-specific, credential-adjacent or infra-related here.
documentation-private/

# Agent guidance file, intentionally unversioned
AGENTS.md

# Local agent/LSP tooling config, intentionally unversioned
.omp/

# User-specific files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.codeiumignore
.windsurfrules
project-rules.mdc

# Logs
logs/
*.log
npm-debug.log*

# Dependency directories
node_modules/
vendor/

# Uploads directory - exclude all files except specific ones we want to keep
# Exclude all files in uploads directory
public/uploads/*
public/uploads/**/*

# But keep these directories
!public/uploads/
!public/uploads/companies/
!public/uploads/logos/
!public/uploads/placeholders/

# Keep default company SVG files
!public/uploads/companies/environmental-company.svg
!public/uploads/companies/healthcare-company.svg
!public/uploads/companies/software-company.svg

